# -----------------------------------------------------------------------------
# 武汉同济医院号源：捕获渠道（自行在合法前提下抓包观察）
# - 主入口多为官方微信小程序「华中科技大学同济医学院附属同济医院」或地区统一预约平台；
# - 网页挂号：Chrome/Edge → F12 → Network → Fetch/XHR，操作到「医生排班/余号」步骤；
# - 小程序：真机 Wi‑Fi + Charles/mitmproxy 等 MITM，或开发者工具 Network（以实际为准）；
# 请勿将 token、Cookie 提交到 Git；勿高频轮询以免触发风控。
# -----------------------------------------------------------------------------

PORT=3000
HOST=127.0.0.1

WECHAT_APP_ID=wx3d8692defee95f21
WECHAT_APP_SECRET=

# 订阅消息模板 ID（公众平台申请，与小程序内文案字段一致）；多个用英文逗号分隔，取第一个用于发送
WECHAT_SUBSCRIBE_TEMPLATE_ID=
# 候补成功模板字段：time1=候补成功时间，short_thing2=候补节点，thing3=温馨提示
# 可使用占位符：doctorName hospitalName campusName departmentName registrationType monitorId checkedAt availabilityTime alertTip
WECHAT_SUBSCRIBE_TEMPLATE_DATA_JSON={"time1":{"value":"{{availabilityTime}}"},"short_thing2":{"value":"{{doctorName}}"},"thing3":{"value":"{{alertTip}}"}}
WECHAT_SUBSCRIBE_PAGE=pages/index/index
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=formal

# 登录白名单：非空时，仅这些 openid 可完成「订阅注册」与接收提醒
ALLOWED_OPENIDS=
# 额外持久通知名单（可选，逗号分隔）；用户在小程序里点「订阅有号提醒」也会写入 server/data/notify-openids.json
NOTIFY_OPENIDS=

MONITOR_WINDOW_DAYS=14
HOSPITAL_API_ENABLED=false
DEBUG_RAW_HOSPITAL_RESPONSE=false

# 医院「余号查询」HTTP（整段来自抓包后脱敏配置）
HOSPITAL_RESPONSE_FORMAT=tjh_reg_sources
HOSPITAL_AVAILABILITY_URL=https://www.tjhonline.com.cn/app-gateway/offline/regSource/getDoctorRegSourcesMap?businessType=offline_normal_new&isShowNone=true&startDate={{startDate}}&endDate={{endDate}}&doctorCode={{doctorCode}}
HOSPITAL_AVAILABILITY_METHOD=GET
HOSPITAL_AVAILABILITY_HEADERS_JSON={}
HOSPITAL_AVAILABILITY_BODY_JSON=

# 按 monitors 里的 id 覆盖占位符，如同济排班接口需要的医生编码、科室 id 等
# 林星光 doctorCode 已知为 101573；凃巍需要抓包后补充 doctorCode
HOSPITAL_DOCTOR_SOURCE_CONFIG_JSON={"lin-xingguang":{"doctorCode":"101573","hospitalId":"H0002","specCode":"020302"},"tu-wei":{"doctorCode":"REPLACE","specCode":"010108"}}
MONITOR_AUTO_POLL_ENABLED=false
MONITOR_PRIORITY_START=16:50
MONITOR_PRIORITY_END=17:10
MONITOR_PRIORITY_MIN_SECONDS=1
MONITOR_PRIORITY_MAX_SECONDS=5
MONITOR_NORMAL_MIN_MINUTES=1
MONITOR_NORMAL_MAX_MINUTES=10

# 余号判断：默认关键词匹配整段 JSON 文本；若响应结构化，可改用 JSON 点号路径（设了以后优先于关键词）
HOSPITAL_AVAILABILITY_POSITIVE_JSONPATH=
HOSPITAL_AVAILABLE_KEYWORDS=有号,可预约,剩余
HOSPITAL_UNAVAILABLE_KEYWORDS=无号,约满,停诊

# Header/URL 中可使用 {{accessToken}}；下列二选一：直接写死 token，或通过单独接口刷新
HOSPITAL_ACCESS_TOKEN=
# HOSPITAL_ACCESS_TOKEN_URL=https://auth.example.com/oauth/token
# HOSPITAL_ACCESS_TOKEN_METHOD=POST
# HOSPITAL_ACCESS_TOKEN_HEADERS_JSON={"Content-Type":"application/json"}
# HOSPITAL_ACCESS_TOKEN_BODY_JSON={"grant_type":"client_credentials"}
# HOSPITAL_ACCESS_TOKEN_RESPONSE_FIELD=access_token
# HOSPITAL_ACCESS_TOKEN_EXPIRES_FIELD=expires_in
# HOSPITAL_ACCESS_TOKEN_TTL_SECONDS=3600

# 开发调试用：mock 模式下也在 false->true 时发订阅（正式勿开）
NOTIFY_ON_MOCK_TRANSITION=false
