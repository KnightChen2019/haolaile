<view class="page">
  <view class="hero">
    <view>
      <view class="eyebrow">武汉同济医院</view>
      <view class="title">号源监控</view>
    </view>
    <view class="pill">{{systemStatus}}</view>
  </view>

  <view class="toolbar">
    <button size="mini" bindtap="loadMonitors">刷新</button>
    <button size="mini" bindtap="goSettings">设置</button>
  </view>

  <view class="summary">
    <view>
      <view class="summary-value">{{windowDays}}</view>
      <view class="summary-label">滚动天数</view>
    </view>
    <view>
      <view class="summary-value">{{enabledCount}}</view>
      <view class="summary-label">监控医生</view>
    </view>
    <view>
      <view class="summary-value">{{lastCheckedText}}</view>
      <view class="summary-label">最近检查</view>
    </view>
  </view>

  <view class="section-title">医生</view>

  <view wx:if="{{loading}}" class="empty">正在读取监控状态...</view>
  <view wx:elif="{{error}}" class="empty error">{{error}}</view>

  <view wx:else>
    <view wx:for="{{monitors}}" wx:key="id" class="doctor-card" bindtap="openDetail" data-id="{{item.id}}">
      <view class="doctor-main">
        <view>
          <view class="doctor-name">{{item.doctorName}}</view>
          <view class="doctor-meta">{{item.departmentName}} · {{item.campusName}} · {{item.registrationType}}</view>
        </view>
        <view class="status {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="result">{{item.lastResultSummary}}</view>
      <view class="priority">重点时段：{{item.priorityWindow}}</view>
      <view class="doctor-footer">
        <text>最近检查：{{item.lastCheckedAtText}}</text>
        <text>{{item.enabled ? "监控中" : "已暂停"}}</text>
      </view>
    </view>
  </view>
</view>
