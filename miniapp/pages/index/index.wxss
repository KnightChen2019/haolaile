.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #0f766e;
  color: #fff;
}

.eyebrow {
  font-size: 24rpx;
  opacity: 0.82;
}

.title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.pill {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 22rpx;
  border: 1rpx solid #dbe5e2;
  border-radius: 8rpx;
  background: #fff;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 6rpx;
  color: #64716f;
  font-size: 22rpx;
}

.doctor-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #dbe5e2;
  border-radius: 8rpx;
  background: #fff;
}

.doctor-main,
.doctor-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.doctor-name {
  font-size: 34rpx;
  font-weight: 750;
}

.doctor-meta,
.doctor-footer {
  margin-top: 8rpx;
  color: #64716f;
  font-size: 24rpx;
}

.status {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-ok {
  background: #dcfce7;
  color: #166534;
}

.status-paused {
  background: #f1f5f9;
  color: #475569;
}

.status-found {
  background: #fee2e2;
  color: #991b1b;
}

.result {
  margin-top: 20rpx;
  font-size: 28rpx;
}

.priority {
  margin-top: 10rpx;
  color: #0f766e;
  font-size: 24rpx;
}

.empty {
  padding: 32rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #64716f;
  text-align: center;
}

.error {
  color: #b91c1c;
}
